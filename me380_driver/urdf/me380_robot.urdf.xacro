<?xml version="1.0"?>
<!--
  ME380 6-DOF arm - Classical DH (Craig convention).
  For MoveIt: joint names joint1..joint6, end-effector at ee_link.
  Adjust joint lengths/offsets by editing the DH properties below.
  Replace box visuals with <mesh filename="package://me380_driver/meshes/...stl"/> later.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="me380">

  <!-- ============ DH PARAMETERS – edit these to change joint lengths and offsets ============ -->
  <!-- Format: theta (joint var), d, alpha (rad), a. Non-zero only listed. -->
  <!-- d (link offset along z): -->
  <xacro:property name="dh_d1" value="0.244107"/>   <!-- base to shoulder -->
  <xacro:property name="dh_d4" value="0.1632"/>     <!-- upper arm to forearm -->
  <xacro:property name="dh_d6" value="0.13878"/>    <!-- wrist to end-effector -->
  <!-- a (link length along x): -->
  <xacro:property name="dh_a1" value="-0.062242"/>  <!-- shoulder offset -->
  <xacro:property name="dh_a2" value="0.21575"/>    <!-- upper arm length -->
  <!-- alpha in radians (-90° = -pi/2, 90° = pi/2): -->
  <xacro:property name="alpha1" value="-1.5707963267948966"/>
  <xacro:property name="alpha3" value="1.5707963267948966"/>
  <xacro:property name="alpha4" value="-1.5707963267948966"/>
  <xacro:property name="alpha5" value="1.5707963267948966"/>

  <!-- ============ Link box sizes (placeholder visuals; replace with STLs later) ============ -->
  <xacro:property name="base_x" value="0.12"/>
  <xacro:property name="base_y" value="0.12"/>
  <xacro:property name="base_z" value="0.04"/>
  <xacro:property name="link1_size" value="0.06"/>
  <xacro:property name="link2_x" value="0.22"/>
  <xacro:property name="link2_y" value="0.05"/>
  <xacro:property name="link2_z" value="0.05"/>
  <xacro:property name="link3_size" value="0.05"/>
  <xacro:property name="link4_x" value="0.06"/>
  <xacro:property name="link4_y" value="0.06"/>
  <xacro:property name="link4_z" value="0.17"/>
  <xacro:property name="link5_size" value="0.04"/>
  <xacro:property name="link6_x" value="0.04"/>
  <xacro:property name="link6_y" value="0.04"/>
  <xacro:property name="link6_z" value="0.14"/>

  <!-- ============ Base ============ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${base_z/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_x} ${base_y} ${base_z}"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 ${base_z/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${base_x} ${base_y} ${base_z}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${base_z/2}" rpy="0 0 0"/>
      <mass value="1"/>
      <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
    </inertial>
  </link>

  <!-- Joint 1: base rotation. DH origin (a1, 0, d1), R_x(alpha1) -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="${dh_a1} 0 ${dh_d1}" rpy="${alpha1} 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="1"/>
  </joint>
  <link name="link1">
    <visual>
      <origin xyz="${link1_size/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${link1_size} ${link1_size} ${link1_size}"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.4 0.8 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="${link1_size/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${link1_size} ${link1_size} ${link1_size}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${link1_size/2} 0 0" rpy="0 0 0"/>
      <mass value="0.5"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
  </link>

  <!-- Joint 2: shoulder. DH a2, d2=0, alpha2=0 -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="${dh_a2} 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="1"/>
  </joint>
  <link name="link2">
    <visual>
      <origin xyz="${link2_x/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${link2_x} ${link2_y} ${link2_z}"/>
      </geometry>
      <material name="orange">
        <color rgba="0.9 0.5 0.1 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="${link2_x/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${link2_x} ${link2_y} ${link2_z}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${link2_x/2} 0 0" rpy="0 0 0"/>
      <mass value="0.8"/>
      <inertia ixx="0.005" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.005"/>
    </inertial>
  </link>

  <!-- Joint 3: elbow. DH a3=0, d3=0, alpha3=90° -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0" rpy="${alpha3} 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="1"/>
  </joint>
  <link name="link3">
    <visual>
      <origin xyz="${link3_size/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${link3_size} ${link3_size} ${link3_size}"/>
      </geometry>
      <material name="green">
        <color rgba="0.2 0.7 0.3 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="${link3_size/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${link3_size} ${link3_size} ${link3_size}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${link3_size/2} 0 0" rpy="0 0 0"/>
      <mass value="0.3"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <!-- Joint 4: wrist 1. DH a4=0, d4, alpha4=-90° -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 ${dh_d4}" rpy="${alpha4} 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="1"/>
  </joint>
  <link name="link4">
    <visual>
      <origin xyz="${link4_x/2} 0 ${link4_z/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${link4_x} ${link4_y} ${link4_z}"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0.2 0.2 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="${link4_x/2} 0 ${link4_z/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${link4_x} ${link4_y} ${link4_z}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${link4_x/2} 0 ${link4_z/2}" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.0005"/>
    </inertial>
  </link>

  <!-- Joint 5: wrist 2. DH a5=0, d5=0, alpha5=90° -->
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 0" rpy="${alpha5} 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="1"/>
  </joint>
  <link name="link5">
    <visual>
      <origin xyz="${link5_size/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${link5_size} ${link5_size} ${link5_size}"/>
      </geometry>
      <material name="purple">
        <color rgba="0.5 0.2 0.6 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="${link5_size/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${link5_size} ${link5_size} ${link5_size}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${link5_size/2} 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <!-- Joint 6: wrist 3. DH a6=0, d6 -->
  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="0 0 ${dh_d6}" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14159" upper="3.14159" effort="10" velocity="1"/>
  </joint>
  <link name="link6">
    <visual>
      <origin xyz="${link6_x/2} 0 ${link6_z/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${link6_x} ${link6_y} ${link6_z}"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1"/>
      </material>
    </visual>
    <collision>
      <origin xyz="${link6_x/2} 0 ${link6_z/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${link6_x} ${link6_y} ${link6_z}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="${link6_x/2} 0 ${link6_z/2}" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0003" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- End-effector link for MoveIt (planning frame / tip of robot) -->
  <joint name="ee_fixed" type="fixed">
    <parent link="link6"/>
    <child link="ee_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>
  <link name="ee_link"/>

</robot>
