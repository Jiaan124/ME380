<?xml version="1.0"?>
<!--
  ME380 6-DOF arm - Classical DH from DH-Table.
  Link i: alpha_{i-1} (°), a_{i-1}, d_i, theta_i (°). Theta is the joint variable.
  Joint names joint1..joint6, end-effector at ee_link.
  Replace box visuals with <mesh filename="package://me380_driver/meshes/...stl"/> later.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="me380">


  <!-- alpha in radians (90° = pi/2): -->
  <xacro:property name="alpha1" value="0.0"/>                    <!-- Link 1: 0° -->
  <xacro:property name="alpha2" value="-1.5707963267948966"/>      <!-- Link 2: 90° -->
  <xacro:property name="alpha3" value="0.0"/>                       <!-- Link 3: 0° -->
  <xacro:property name="alpha4" value="1.5707963267948966"/>        <!-- Link 4: 90° -->
  <xacro:property name="alpha5" value="1.5707963267948966"/>        <!-- Link 5: 90° -->
  <xacro:property name="alpha6" value="1.5707963267948966"/>       <!-- Link 6: 90° -->

  <!-- ============ Visual geometry: boxes follow kinematic chain (outline of robot) ============ -->

  <!-- Cross-section thickness for arm links -->
  <xacro:property name="thick" value="0.03"/>
  <!-- Height and offset of slanted shoulder-->
  <xacro:property name="link1_height" value="0.2391"/>
  <xacro:property name="link1_side_offset" value="-0.0622"/>

  <!-- Elbow (middle piece) length -->
  <xacro:property name="link2_len" value="0.2355"/>
  <!-- 3rd to 4th dof length (4th dof is new added dof) to face of 4th dof -->
  <xacro:property name="link3_len" value="0.103"/>
  <!-- end of 4th dof to write differential -->
  <xacro:property name="link4_len" value="0.110"/>
  <!-- placeholder length -->
  <xacro:property name="link5_len" value="0.0"/>
  <!-- link6: diff to midl of gripper dist-->
  <xacro:property name="gripper_len" value="0.112"/>

  <!-- ============ Base ============ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <box size="0.15, 0.15, 0.05"/>
      </geometry>
      <material name="grey">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
  </link>

  <!-- Joint 1: base rotation. DH (a0=0, d1=1, alpha0=0°) -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0" rpy="${alpha1} 0 0"/>
    <axis xyz="0 0 -1"/>
    <!-- +-170 deg limits -->
    <limit lower="-2.96706" upper="2.96706" effort="10" velocity="1"/>
  </joint>
  <link name="link1">
    <!-- Horizontal segment: from origin to joint2 (length a2 = 0.2 along x) -->
    <visual>
      <origin xyz="${link1_side_offset/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${link1_side_offset} ${thick} ${thick}"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.4 0.8 1"/>
      </material>
    </visual>

    <!-- Vertical segment: d1 downward (column from joint1 down toward base) -->
    <visual>
      <origin xyz="0 0 ${link1_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${thick} ${thick} ${link1_height}"/>
      </geometry>
      <material name="blue">
        <color rgba="0.2 0.4 0.8 1"/>
      </material>
    </visual>
  </link>

  <!-- Joint 2: shoulder. DH (a1=-0.2, d2=0, alpha1=90°) -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="${link1_side_offset} 0 ${link1_height}" rpy="${alpha2} 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-0.08727" upper="3.92699" effort="10" velocity="1"/>
  </joint>
  <link name="link2">
    <visual>
      <origin xyz="${link2_len/2} 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="${link2_len} ${thick} ${thick}"/>
      </geometry>
      <material name="orange">
        <color rgba="0.9 0.5 0.1 1"/>
      </material>
    </visual>
  </link>

  <!-- Joint 3: elbow. DH (a2=1, d3=0, alpha2=0°). Axis same as joint2: both rotate about link2 z (0 1 0 in link3 = link2’s z after R_x(90) from link1). -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="${link2_len} 0 0" rpy="${alpha3} 0 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-1.74533" upper="1.74533" effort="10" velocity="1"/>
  </joint>
  <link name="link3">
    <visual>
      <origin xyz="${link3_len/2} 0 0 " rpy="0 0 0"/>
      <geometry>
        <box size=" ${link3_len} ${thick} ${thick}"/>
      </geometry>
      <material name="green">
        <color rgba="0.2 0.7 0.3 1"/>
      </material>
    </visual>
  </link>

  <!-- Joint 4: wrist 1. DH (a3=0, d4=1, alpha3=90°) -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="${link3_len} 0 0" rpy="0 ${alpha4} 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-2.61799" upper="2.61799" effort="10" velocity="1"/>
  </joint>
  <link name="link4">
    <visual>
      <origin xyz=" 0 0 ${link4_len/2}" rpy="0 0 0"/>
      <geometry>
        <box size=" ${thick} ${thick} ${link4_len}"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0.2 0.2 1"/>
      </material>
    </visual>
  </link>

  <!-- Joint 5: wrist 2. DH (a4=-0.5, d5=0, alpha4=90°) -->
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 ${link4_len}" rpy=" 0 ${alpha5} 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57080" upper="1.57080" effort="10" velocity="1"/>
  </joint>
  <link name="link5">
    <visual>
      <origin xyz="-${link5_len/2} 0 0 " rpy="0 0 0"/>
      <geometry>
        <box size=" ${link5_len} ${thick} ${thick}"/>
      </geometry>
      <material name="purple">
        <color rgba="0.5 0.2 0.6 1"/>
      </material>
    </visual>
  </link>

  <!-- Joint 6: wrist 3. DH (a5=0, d6=0.3, alpha5=90°) -->
  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin xyz="-${link5_len} 0 0" rpy=" 0 ${alpha6} 0"/>
    <axis xyz="0 0 -1"/>
    <limit lower="-2.96706" upper="2.96706" effort="10" velocity="1"/>
  </joint>
  <link name="link6">
    <visual>
      <origin xyz="0 0 ${-gripper_len/2}" rpy="0 0 0"/>
      <geometry>
        <box size=" ${thick} ${thick} ${gripper_len}"/>
      </geometry>
      <material name="dark_grey">
        <color rgba="0.3 0.3 0.3 1"/>
      </material>
    </visual>

  </link>

  <!-- End-effector link for MoveIt (planning frame / tip of robot) -->
  <joint name="ee_fixed" type="fixed">
    <parent link="link6"/>
    <child link="ee_link"/>
    <origin xyz="0 0 ${-gripper_len}" rpy="0 0 0"/>
  </joint>
  <link name="ee_link">
    <visual>
      <origin xyz="0 0 ${-thick/2}" rpy="0 0 0"/>
      <geometry>
        <box size=" ${thick} ${thick} ${thick}"/>
      </geometry>
      <material name="red">
        <color rgba="0.8 0.2 0.2 1"/>
      </material>
    </visual>

  </link>
</robot>
